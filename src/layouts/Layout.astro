---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";
import "@fontsource-variable/sixtyfour";
import "@fontsource/tomorrow";
interface Props {
    title: string;
    description: string;
    showMarquee?: boolean;
}
const { title, description, showMarquee = false } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/x-icon" href="/favicon.png" />
        <title>{title} | bebsi</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <Header showMarquee={showMarquee} />
        <div id="content">
            <Sidebar>
                <h2>SITEMAP</h2>
                <nav>
                    <ul>
                        <li>
                            <a href="/">Home</a>
                        </li>
                        <li>
                            <a href="/blog">Blog</a>
                        </li>
                        <li>
                            <a href="/projects">Projects</a>
                        </li>
                        <li>
                            <a href="/gallery">Gallery</a>
                        </li>
                        <li>
                            <a href="/snep">Sneps...</a>
                        </li>
                    </ul>
                </nav>
            </Sidebar>
            <main>
                <slot />
            </main>
            <Sidebar>
                <h2>TO DO!</h2>
                <p>- Changing header image and accents</p>
                <p>- Add 88x31's</p>
                <p>- Add content to pages</p>
            </Sidebar>
        </div>
        <Footer />
    </body>
</html>

<style>
    html {
        background-color: black;
        background-image: url("/Hexagon_Tiling.svg");
        background-repeat: repeat;
        background-size: calc(100vw / 6) auto;
    }
    body {
        margin: 0 auto var(--section-gap) auto;
        display: flex;
        flex-direction: column;
        max-width: 1320px;
        padding: 0 var(--section-gap);
    }
    #content {
        display: flex;
        flex-direction: row;
        gap: var(--section-gap);
        margin-bottom: var(--section-gap);
    }
    main {
        display: flex;
        flex-direction: column;
        gap: var(--section-gap);
        flex-grow: 1;
    }
    main > :global(section:first-of-type) {
        min-height: 800px;
    }
</style>
