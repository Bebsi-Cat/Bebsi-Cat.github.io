---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";
import "@fontsource-variable/sixtyfour";
import "@fontsource/tomorrow";
interface Props {
    title: string;
    description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/x-icon" href="/favicon.png" />
        <title>{title} | bebsi</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <Header />
        <div id="content">
            <Sidebar>
                <h2>SITEMAP</h2>
                <p>Buttons here!</p>
            </Sidebar>
            <main>
                <slot />
            </main>
            <Sidebar>
                <h2>TO DO!</h2>
                <p>- Changing header image</p>
                <p>- Add 88x31's</p>
                <p>- ADD THE SNEP PAGE</p>
                <p>- Add more pages:</p>
                <p>Blog</p>
                <p>Projects</p>
                <p>Gallary</p>
                <p>About me?</p>
            </Sidebar>
        </div>
        <Footer />
    </body>
</html>

<style>
    html {
        background-color: black;
        background-image: url("/Hexagon_Tiling.svg");
        background-repeat: repeat;
        background-size: calc(100vw / 6) auto;
    }
    body {
        margin: 0 auto var(--section-gap) auto;
        display: flex;
        flex-direction: column;
        max-width: 1320px;
        padding: 0 var(--section-gap);
    }
    #content {
        display: flex;
        flex-direction: row;
        gap: var(--section-gap);
        margin-bottom: var(--section-gap);
    }
    main {
        display: flex;
        flex-direction: column;
        gap: var(--section-gap);
        flex-grow: 1;
    }
    main > :global(section:first-of-type) {
        min-height: 800px;
    }
</style>
