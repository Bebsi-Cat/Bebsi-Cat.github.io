---
interface Props {
    showMarquee: boolean;
}

const { showMarquee = false } = Astro.props;
---

<header>
    <figure class="header-image">
        <img id="header-image" alt="Header image not loaded" />
        <figcaption id="credit">
            Dmitry Abukaev (Milsim visions x 02)
        </figcaption>
    </figure>
    {showMarquee && (
        <div id="marquee-container">
            <marquee>
                <span>Blah blah blah blah blah</span>
                <span>Blah blah blah blah blah</span>
            </marquee>
        </div>
    )}
</header>

<script>
    const creditText = document.getElementById("credit");
    const headerImg = document.getElementById(
        "header-image",
    ) as HTMLImageElement;
    window.addEventListener("theme-updated", (event) => {
        const customEvent = event as CustomEvent;
        const { id, name, headerImage, altText, credit, accentColour } =
            customEvent.detail;
        if (creditText && credit) {
            creditText.textContent = credit;
        }
        console.log(headerImage);
        if (headerImg && headerImage) {
            headerImg.src = `/header-images/${headerImage}`;
            headerImg.alt = altText;
        }
    });
</script>

<style>
    header {
        max-width: calc(1320px - var(--section-gap) * 2);
        display: flex;
        flex-direction: column;
        gap: var(--section-gap);
    }
    marquee {
        span {
            margin: 0 10px;
        }
    }
    .header-image {
        position: relative;
        margin: 0;
        display: inline-block;
        #header-image {
            display: inline-block;
            width: calc(1320px - var(--section-gap) * 2);
            height: 300px;
            object-fit: cover;
            object-position: 50% 50%;
        }
    }
    #credit {
        position: absolute;
        right: 10px;
        bottom: 10px;
        padding: 10px;
    }
    #marquee-container {
        background-color: var(--section-background-colour);
        padding: var(--section-padding);
        box-sizing: border-box;
        border-top: var(--section-border);
        border-bottom: var(--section-border);
    }
</style>
