---
import { Image } from "astro:assets";
import headerImage from "../assets/headerimg.jpg";
import Section from "./Section.astro";
---

<header>
    <Image
        src={headerImage}
        alt="Header image of russian (T-90) tanks in snowy field"
        width={1320}
        height={300}
        layout="full-width"
    />
    <Section>
        <marquee>
            <span>Blah blah blah blah blah</span>
            <span>Blah blah blah blah blah</span>
        </marquee>
    </Section>
</header>

<style>
    header {
        display: flex;
        flex-direction: column;
        margin-bottom: 16px;
        gap: 16px;
    }
    marquee {
        span {
            margin: 0 10px;
        }
    }
</style>
