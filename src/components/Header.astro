---
import { Image } from "astro:assets";
import headerImage from "../assets/headerimg.jpg";
import Section from "./Section.astro";
---

<header>
    <figure class="header-image">
        <Image
            src={headerImage}
            alt="Header image of russian (T-90) tanks in snowy field"
            width={1320}
            height={300}
            layout="full-width"
        />
        <figcaption class="credit">
            Dmitry Abukaev (Milsim visions x 02)
        </figcaption>
    </figure>
    <Section>
        <marquee>
            <span>Blah blah blah blah blah</span>
            <span>Blah blah blah blah blah</span>
        </marquee>
    </Section>
</header>

<style>
    header {
        display: flex;
        flex-direction: column;
        margin-bottom: 16px;
        gap: 16px;
    }
    marquee {
        span {
            margin: 0 10px;
        }
    }
    .header-image {
        position: relative;
        margin: 0;
        display: inline-block;
    }
    .credit {
        position: absolute;
        right: 10px;
        bottom: 10px;
        padding: 10px;
    }
</style>
