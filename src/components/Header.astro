---
import { Image } from "astro:assets";
import headerImage from "../assets/headerimg.jpg";
import Section from "./Section.astro";
---

<header>
    <Image
        src={headerImage}
        alt="Header image of russian (T-90) tanks in snowy field"
        width={1320}
        height={300}
        layout="full-width"
    />
    <Section>
        <p>Blah blah blah blah blah</p>
    </Section>
</header>

<style>
    header {
        display: flex;
        flex-direction: column;
        margin-bottom: 16px;
        gap: 16px;
    }
    p {
        margin: 0;
    }
</style>
